+#pragma mark - Lazy specialized subviews
+
+- (UIImageView *)artwork {
+	if (!_artwork) {
+		_artwork = [[UIImageView alloc] init];
+		_artwork.hidden = YES;
+		_artwork.contentMode = UIViewContentModeScaleAspectFill;
+		_artwork.clipsToBounds = YES;
+		_artwork.layer.cornerRadius = TGMetricCornerSmall;
+		[self.bubble addSubview:_artwork];
+	}
+	return _artwork;
+}
+
+- (UIImageView *)disc {
+	if (!_disc) {
+		_disc = [[UIImageView alloc] init];
+		_disc.hidden = YES;
+		[self.bubble addSubview:_disc];
+	}
+	return _disc;
+}
+
+- (UIImageView *)wave {
+	if (!_wave) {
+		_wave = [[UIImageView alloc] init];
+		_wave.hidden = YES;
+		[self.bubble addSubview:_wave];
+	}
+	return _wave;
+}
+
+- (UIImageView *)senderAvatar {
+	if (!_senderAvatar) {
+		_senderAvatar = [[UIImageView alloc] init];
+		_senderAvatar.layer.cornerRadius = TGHalf(TGMetricGroupAvatarSide);
+		_senderAvatar.hidden = YES;
+		[self.contentView addSubview:_senderAvatar];
+	}
+	return _senderAvatar;
+}
+
+- (UIView *)unreadDot {
+	if (!_unreadDot) {
+		_unreadDot = [[UIView alloc] init];
+		_unreadDot.hidden = YES;
+		_unreadDot.backgroundColor = [[TGTheme shared] accentColour];
+		[self.contentView addSubview:_unreadDot];
+	}
+	return _unreadDot;
+}
+
+- (UIImageView *)checkbox {
+	if (!_checkbox) {
+		_checkbox = [[UIImageView alloc] init];
+		_checkbox.hidden = YES;
+		_checkbox.contentMode = UIViewContentModeCenter;
+		[self.contentView addSubview:_checkbox];
+	}
+	return _checkbox;
+}
+
+- (TGLottieView *)lottie {
+	if (!_lottie) {
+		_lottie = [[TGLottieView alloc] initWithFrame:CGRectZero];
+		_lottie.hidden = YES;
+		[self.bubble addSubview:_lottie];
+	}
+	return _lottie;
+}
+
+- (UIView *)collageView {
+	if (!_collageView) {
+		_collageView = [[UIView alloc] init];
+		_collageView.hidden = YES;
+		_collageView.clipsToBounds = YES;
+		self.collageViews = [NSMutableArray arrayWithCapacity:4];
+		for (NSInteger i = 0; i < 4; i++) {
+			UIImageView *cv = [[UIImageView alloc] init];
+			cv.contentMode = UIViewContentModeScaleAspectFill;
+			cv.layer.cornerRadius = TGMetricCornerSmall;
+			cv.userInteractionEnabled = YES;
+			cv.tag = i;
+			UITapGestureRecognizer *tap = [[UITapGestureRecognizer alloc] initWithTarget:self action:@selector(collageItemTapped:)];
+			[cv addGestureRecognizer:tap];
+			[self.collageViews addObject:cv];
+			[_collageView addSubview:cv];
+		}
+		[self.bubble addSubview:_collageView];
+	}
+	return _collageView;
+}
+
+- (UILabel *)collageMoreLabel {
+	if (!_collageMoreLabel) {
+		_collageMoreLabel = [[UILabel alloc] init];
+		_collageMoreLabel.textAlignment = NSTextAlignmentCenter;
+		_collageMoreLabel.textColor = [[TGTheme shared] onMediaColour];
+		_collageMoreLabel.font = TGFontHeader();
+		_collageMoreLabel.backgroundColor = [[TGTheme shared] mediaOverlayColour];
+		_collageMoreLabel.layer.cornerRadius = TGMetricCornerSmall;
+		_collageMoreLabel.clipsToBounds = YES;
+		_collageMoreLabel.hidden = YES;
+		[self.collageView addSubview:_collageMoreLabel];
+	}
+	return _collageMoreLabel;
+}
+
+- (UILabel *)captionLabel {
+	if (!_captionLabel) {
+		_captionLabel = [[UILabel alloc] init];
+		_captionLabel.numberOfLines = 0;
+		_captionLabel.lineBreakMode = NSLineBreakByWordWrapping;
+		_captionLabel.font = TGFontBody();
+		_captionLabel.backgroundColor = [UIColor clearColor];
+		_captionLabel.hidden = YES;
+		[self.bubble addSubview:_captionLabel];
+	}
+	return _captionLabel;
+}
