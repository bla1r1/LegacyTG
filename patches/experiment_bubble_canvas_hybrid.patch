+		if (ctx) {
+			CGContextSaveGState(ctx);
+			CGContextClipToRect(ctx, self.textRect);
+		}
+		[self.quoteAttributedText drawInRect:self.textRect];
+		if (ctx)
+			CGContextRestoreGState(ctx);
+	} else if (self.quoteText.length && !CGRectIsEmpty(self.textRect)) {
+		TGDrawText(self.quoteText, self.textRect, self.quoteFont ?: TGFontCaption(),
